:root{
  --bg:#f4f6f8;--panel:#ffffff;--panel-2:#f8fafc;--text:#111827;--muted:#667085;--border:#e3e8ef;
  --accent:#5b5bd6;--accent-2:#ececff;--danger:#c63d4f;--danger-bg:#fff1f2;--warn:#a86f00;--warn-bg:#fff8db;
  --ok:#157f5b;--ok-bg:#eaf8f2;--shadow:0 12px 32px rgba(15,23,42,.08);--radius:14px;--sidebar:232px;
}
:root.dark{
  --bg:#0c1119;--panel:#121925;--panel-2:#0f1621;--text:#edf2f7;--muted:#9aa8bb;--border:#263241;
  --accent:#8d8df5;--accent-2:#23234a;--danger:#ff8092;--danger-bg:#321820;--warn:#f4bf55;--warn-bg:#342a15;
  --ok:#60d6aa;--ok-bg:#173229;--shadow:0 14px 38px rgba(0,0,0,.32);
}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit;color:inherit}.hidden{display:none!important}
#app{min-height:100vh;display:grid;grid-template-columns:var(--sidebar) 1fr}.sidebar{position:fixed;inset:0 auto 0 0;width:var(--sidebar);background:var(--panel);border-right:1px solid var(--border);padding:18px 14px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;gap:11px;align-items:center;padding:4px 6px 22px}.brand-mark{width:35px;height:35px;border-radius:10px;display:grid;place-items:center;background:var(--text);color:var(--panel);font-weight:800}.brand strong{display:block;font-size:15px}.brand span{display:block;color:var(--muted);font-size:11px;margin-top:2px}.nav{display:grid;gap:4px}.nav button{border:0;background:transparent;text-align:left;padding:10px 11px;border-radius:10px;color:var(--muted);cursor:pointer;font-weight:600}.nav button span{display:inline-block;width:22px}.nav button:hover{background:var(--panel-2);color:var(--text)}.nav button.active{background:var(--accent-2);color:var(--accent)}.sidebar-foot{margin-top:auto}.ghost-btn{border:1px solid var(--border);background:transparent;border-radius:9px;padding:8px 10px;cursor:pointer;width:100%;text-align:left}.archive-stamp{font-size:10px;line-height:1.45;color:var(--muted);padding:12px 4px 0}
.main{grid-column:2;min-width:0}.topbar{height:64px;background:color-mix(in srgb,var(--panel) 92%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:15;display:flex;align-items:center;gap:14px;padding:0 24px}.menu-btn{display:none;border:0;background:transparent;font-size:20px}.search-wrap{flex:1;max-width:720px;border:1px solid var(--border);background:var(--panel-2);height:38px;border-radius:10px;display:flex;align-items:center;padding:0 10px;gap:8px}.search-wrap input{flex:1;background:transparent;border:0;outline:0;min-width:0}.search-wrap kbd{font-size:11px;border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;padding:1px 6px;color:var(--muted);background:var(--panel)}.top-actions{margin-left:auto;color:var(--muted);font-size:12px;display:flex;align-items:center;gap:7px}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--ok)}.content{padding:28px;max-width:1500px;margin:0 auto}.loading{color:var(--muted);padding:60px;text-align:center}
.page-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:24px}.page-title h1{margin:0;font-size:28px;letter-spacing:-.04em}.page-title p{color:var(--muted);margin:7px 0 0;font-size:13px}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--border);background:var(--panel);border-radius:9px;padding:8px 11px;cursor:pointer}.btn:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--border));color:var(--accent)}.btn.primary{background:var(--text);color:var(--panel);border-color:var(--text)}
.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:22px}.stat{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:18px}.stat-label{font-size:12px;color:var(--muted);font-weight:600}.stat-value{font-size:29px;font-weight:750;letter-spacing:-.04em;margin-top:7px}.stat-sub{font-size:11px;color:var(--muted);margin-top:4px}
.grid-2{display:grid;grid-template-columns:1.3fr 1fr;gap:16px}.panel{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}.panel-head{padding:16px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px}.panel-head h2,.panel-head h3{font-size:14px;margin:0}.panel-body{padding:18px}.bar-row{display:grid;grid-template-columns:90px 1fr 72px;gap:10px;align-items:center;margin:12px 0;font-size:12px}.bar-track{height:7px;background:var(--panel-2);border-radius:99px;overflow:hidden}.bar-fill{height:100%;background:var(--accent);border-radius:99px}.bar-count{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}.legend-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.legend-item{padding:12px;border:1px solid var(--border);border-radius:10px}.legend-item strong{display:block;font-size:18px}.legend-item span{color:var(--muted);font-size:11px}.fact-list{display:grid;gap:10px}.fact{border-left:3px solid var(--accent);padding:8px 10px;background:var(--panel-2);border-radius:0 8px 8px 0}.fact b{font-size:12px}.fact p{font-size:11px;color:var(--muted);margin:3px 0 0;line-height:1.5}
