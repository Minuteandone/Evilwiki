:root{
  --bg:#f4f6f8;--panel:#ffffff;--panel-2:#f8fafc;--text:#111827;--muted:#667085;--border:#e3e8ef;
  --accent:#5b5bd6;--accent-2:#ececff;--danger:#c63d4f;--danger-bg:#fff1f2;--warn:#a86f00;--warn-bg:#fff8db;
  --ok:#157f5b;--ok-bg:#eaf8f2;--shadow:0 12px 32px rgba(15,23,42,.08);--radius:14px;--sidebar:232px;
}
:root.dark{
  --bg:#0c1119;--panel:#121925;--panel-2:#0f1621;--text:#edf2f7;--muted:#9aa8bb;--border:#263241;
  --accent:#8d8df5;--accent-2:#23234a;--danger:#ff8092;--danger-bg:#321820;--warn:#f4bf55;--warn-bg:#342a15;
  --ok:#60d6aa;--ok-bg:#173229;--shadow:0 14px 38px rgba(0,0,0,.32);
}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit;color:inherit}.hidden{display:none!important}
#app{min-height:100vh;display:grid;grid-template-columns:var(--sidebar) 1fr}.sidebar{position:fixed;inset:0 auto 0 0;width:var(--sidebar);background:var(--panel);border-right:1px solid var(--border);padding:18px 14px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;gap:11px;align-items:center;padding:4px 6px 22px}.brand-mark{width:35px;height:35px;border-radius:10px;display:grid;place-items:center;background:var(--text);color:var(--panel);font-weight:800}.brand strong{display:block;font-size:15px}.brand span{display:block;color:var(--muted);font-size:11px;margin-top:2px}.nav{display:grid;gap:4px}.nav button{border:0;background:transparent;text-align:left;padding:10px 11px;border-radius:10px;color:var(--muted);cursor:pointer;font-weight:600}.nav button span{display:inline-block;width:22px}.nav button:hover{background:var(--panel-2);color:var(--text)}.nav button.active{background:var(--accent-2);color:var(--accent)}.sidebar-foot{margin-top:auto}.ghost-btn{border:1px solid var(--border);background:transparent;border-radius:9px;padding:8px 10px;cursor:pointer;width:100%;text-align:left}.archive-stamp{font-size:10px;line-height:1.45;color:var(--muted);padding:12px 4px 0}
