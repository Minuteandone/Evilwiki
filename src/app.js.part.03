function descriptionRow(d){return `<article class="description-row" data-page="${esc(d.page_id)}"><div class="description-name"><strong>${esc(d.name)}</strong><span>${esc(d.wiki)} · ${esc(d.page_family||'unknown')}</span></div><p>${esc(d.description)}</p><span class="description-source">${esc(d.description_source||'derived')}</span></article>`}

async function renderEvents(){
  content.innerHTML = head('Event timeline','Inspect save, delete, revert, and probe rows in reverse chronological order.') + `<div class="filters"><input id="eventQ" placeholder="Search page, actor, IP, action…"><select id="eventType"><option value="">All event types</option>${Object.keys(state.meta.event_types).map(x=>`<option>${x}</option>`).join('')}</select><select id="eventWiki"><option value="">All wikis</option>${state.meta.wikis.map(x=>`<option>${x.wiki}</option>`).join('')}</select></div><div id="eventResults"></div>`;
  ['eventQ','eventType','eventWiki'].forEach(id=>$('#'+id).addEventListener(id==='eventQ'?'input':'change',debounce(()=>{state.eventOffset=0;loadEvents()},220))); await loadEvents();
}
async function loadEvents(){
  const box=$('#eventResults'); box.innerHTML='<div class="loading">Loading…</div>';
  const data=await api('events',{q:$('#eventQ').value,type:$('#eventType').value,wiki:$('#eventWiki').value,offset:state.eventOffset,limit:state.eventLimit});
  box.innerHTML = data.rows.length ? `<div class="event-list">${data.rows.map(eventRow).join('')}</div>${pager('event',data)}`:'<div class="empty">No matching events.</div>';
  $$('.event-row[data-page]',box).forEach(el=>el.onclick=()=>{if(el.dataset.page)openPage(el.dataset.page)}); bindPager('event',data,loadEvents);
}
function eventRow(e){const pid=e.page_key?e.page_key.replace('~','/'):''; return `<div class="event-row" data-page="${esc(pid)}"><div class="event-time">${dt(e.time)}</div><div class="event-type"><span class="tag ${esc(e.event_type)}">${esc(e.event_type)}</span>${e.wiki?` <span class="tag">${esc(e.wiki)}</span>`:''}</div><div class="event-main"><strong>${esc(e.page||e.param_family||e.event_id)}</strong><small>${esc(e.change_summary||e.request_action||e.relation_type||'')}</small></div><div class="event-actor">${esc(e.actor_label||e.ip16||'—')}</div></div>`}

async function renderLabels(){
  content.innerHTML = head('Labels','Browse actor labels attached to revisions and save requests.') + `<div class="filters"><input id="labelQ" placeholder="Filter labels…"><select id="labelWiki"><option value="">All wikis</option>${state.meta.wikis.map(x=>`<option>${x.wiki}</option>`).join('')}</select><select id="labelHuman"><option value="">Any type</option><option value="yes">Human handles</option><option value="no">Other labels</option></select><select id="labelSort"><option value="revs_desc">Most revisions</option><option value="pages_desc">Most pages</option><option value="name_asc">Name A–Z</option></select></div><div id="labelResults"></div>`;
  ['labelQ','labelWiki','labelHuman','labelSort'].forEach(id=>$('#'+id).addEventListener(id==='labelQ'?'input':'change',debounce(()=>{state.labelOffset=0;loadLabels()},220))); await loadLabels();
}
async function loadLabels(){
  const box=$('#labelResults'); box.innerHTML='<div class="loading">Loading…</div>';
  const data=await api('labels',{q:$('#labelQ').value,wiki:$('#labelWiki').value,human:$('#labelHuman').value,sort:$('#labelSort').value,offset:state.labelOffset,limit:state.labelLimit});
  box.innerHTML=data.rows.length?`<div class="table-wrap"><table><thead><tr><th>Label</th><th>Stored revisions</th><th>Pages</th><th>IPs</th><th>Wikis</th><th>Span</th></tr></thead><tbody>${data.rows.map(labelRow).join('')}</tbody></table></div>${pager('label',data)}`:'<div class="empty">No matching labels.</div>';
  $$('tbody tr',box).forEach(tr=>tr.onclick=()=>openLabel(tr.dataset.name)); bindPager('label',data,loadLabels);
}
function labelRow(l){const name=l.label||'(blank)'; return `<tr data-name="${esc(l.label)}"><td class="name-cell"><strong>${esc(name)}</strong><span>${l.is_human_handle?'human handle':'label'}</span></td><td>${n(l.stored_revisions)}</td><td>${n(l.stored_revision_pages??l.pages?.length)}</td><td>${n(l.stored_revision_ips)}</td><td>${(l.wikis||[]).map(w=>`<span class="tag">${esc(w)}</span>`).join('')}</td><td>${shortDate(l.first_write)} → ${shortDate(l.last_write)}</td></tr>`}

function pager(kind,data){const start=data.total?data.offset+1:0,end=Math.min(data.total,data.offset+data.limit); return `<div class="pager"><span>${n(start)}–${n(end)} of ${n(data.total)}</span><div><button class="btn" data-${kind}-prev ${data.offset<=0?'disabled':''}>← Prev</button> <button class="btn" data-${kind}-next ${end>=data.total?'disabled':''}>Next →</button></div></div>`}
function bindPager(kind,data,fn){const key=kind+'Offset'; const prev=$(`[data-${kind}-prev]`),next=$(`[data-${kind}-next]`); if(prev)prev.onclick=()=>{state[key]=Math.max(0,data.offset-data.limit);fn()};if(next)next.onclick=()=>{state[key]=data.offset+data.limit;fn()}}

async function openPage(id){
  try{
    const data=await api('page',{id}); const p=data.page;
    drawer.classList.remove('hidden'); drawer.innerHTML=`<div class="drawer-head"><div><h2>${esc(p.name)}</h2><p>${esc(p.page_id)} · ${n(p.n_revs)} revisions · ${n(data.events.length)} related events</p></div><button class="close-btn" id="closeDrawer">×</button></div><div class="drawer-body"><div class="meta-grid">${metaBox('Wiki',p.wiki)}${metaBox('Family',p.page_family||'unknown')}${metaBox('Body bytes',bytes(p.body_bytes))}${metaBox('First write',dt(p.first_write))}${metaBox('Last write',dt(p.last_write))}${metaBox('Live',p.deleted_live?'deleted':'present')}</div>${p.description?`<div class="page-description"><span>Description</span><p>${esc(p.description)}</p></div>`:''}<div>${p.labels.map(x=>`<span class="tag">${esc(x||'(blank)')}</span>`).join(' ')}</div><div class="tabs"><button class="active" data-tab="content">Content</button><button data-tab="revisions">Revisions</button><button data-tab="events">Events</button></div><div id="drawerTab"></div></div>`;
    $('#closeDrawer').onclick=()=>drawer.classList.add('hidden'); $$('.tabs button',drawer).forEach(b=>b.onclick=()=>{ $$('.tabs button',drawer).forEach(x=>x.classList.toggle('active',x===b)); renderPageTab(b.dataset.tab,data)}); renderPageTab('content',data);
  }catch(e){toast(e.message)}
}
function metaBox(k,v){return `<div class="meta-box"><span>${esc(k)}</span><strong>${esc(v)}</strong></div>`}
async function renderPageTab(tab,data){const box=$('#drawerTab');
  if(tab==='content'){const r=data.revisions.at(-1); if(!r){box.innerHTML='<div class="empty">No revision body.</div>';return} box.innerHTML='<div class="loading">Loading latest revision…</div>'; const full=await api('revision',{id:r.rev_id}); box.innerHTML=`<div class="actions" style="margin-bottom:10px"><span class="tag">rev ${full.seq}</span><span class="tag">${esc(full.label||'(blank label)')}</span><span class="muted">${dt(full.time)}</span></div><div class="codebox mono">${esc(full.body)}</div>`}
