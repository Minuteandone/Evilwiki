.main{grid-column:2;min-width:0}.topbar{height:64px;background:color-mix(in srgb,var(--panel) 92%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:15;display:flex;align-items:center;gap:14px;padding:0 24px}.menu-btn{display:none;border:0;background:transparent;font-size:20px}.search-wrap{flex:1;max-width:720px;border:1px solid var(--border);background:var(--panel-2);height:38px;border-radius:10px;display:flex;align-items:center;padding:0 10px;gap:8px}.search-wrap input{flex:1;background:transparent;border:0;outline:0;min-width:0}.search-wrap kbd{font-size:11px;border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;padding:1px 6px;color:var(--muted);background:var(--panel)}.top-actions{margin-left:auto;color:var(--muted);font-size:12px;display:flex;align-items:center;gap:7px}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--ok)}.content{padding:28px;max-width:1500px;margin:0 auto}.loading{color:var(--muted);padding:60px;text-align:center}
.page-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:24px}.page-title h1{margin:0;font-size:28px;letter-spacing:-.04em}.page-title p{color:var(--muted);margin:7px 0 0;font-size:13px}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--border);background:var(--panel);border-radius:9px;padding:8px 11px;cursor:pointer}.btn:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--border));color:var(--accent)}.btn.primary{background:var(--text);color:var(--panel);border-color:var(--text)}
.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:22px}.stat{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:18px}.stat-label{font-size:12px;color:var(--muted);font-weight:600}.stat-value{font-size:29px;font-weight:750;letter-spacing:-.04em;margin-top:7px}.stat-sub{font-size:11px;color:var(--muted);margin-top:4px}
.grid-2{display:grid;grid-template-columns:1.3fr 1fr;gap:16px}.panel{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}.panel-head{padding:16px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px}.panel-head h2,.panel-head h3{font-size:14px;margin:0}.panel-body{padding:18px}.bar-row{display:grid;grid-template-columns:90px 1fr 72px;gap:10px;align-items:center;margin:12px 0;font-size:12px}.bar-track{height:7px;background:var(--panel-2);border-radius:99px;overflow:hidden}.bar-fill{height:100%;background:var(--accent);border-radius:99px}.bar-count{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}.legend-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.legend-item{padding:12px;border:1px solid var(--border);border-radius:10px}.legend-item strong{display:block;font-size:18px}.legend-item span{color:var(--muted);font-size:11px}.fact-list{display:grid;gap:10px}.fact{border-left:3px solid var(--accent);padding:8px 10px;background:var(--panel-2);border-radius:0 8px 8px 0}.fact b{font-size:12px}.fact p{font-size:11px;color:var(--muted);margin:3px 0 0;line-height:1.5}
.filters{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.filters input,.filters select{border:1px solid var(--border);background:var(--panel);border-radius:9px;height:36px;padding:0 10px;outline:none}.filters input{min-width:250px}.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--panel)}table{width:100%;border-collapse:collapse;font-size:12px;min-width:800px}th{text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.06em;padding:11px 13px;background:var(--panel-2);border-bottom:1px solid var(--border)}td{padding:11px 13px;border-bottom:1px solid var(--border);vertical-align:top}tr:last-child td{border-bottom:0}tbody tr{cursor:pointer}tbody tr:hover{background:color-mix(in srgb,var(--accent-2) 55%,transparent)}.name-cell strong{display:block;font-size:12px}.name-cell span{display:block;color:var(--muted);font-size:10px;margin-top:2px}.tag{display:inline-flex;align-items:center;border-radius:999px;padding:3px 7px;font-size:10px;background:var(--panel-2);border:1px solid var(--border);margin:1px}.tag.save{color:var(--ok);background:var(--ok-bg);border-color:transparent}.tag.delete{color:var(--danger);background:var(--danger-bg);border-color:transparent}.tag.probe{color:var(--warn);background:var(--warn-bg);border-color:transparent}.tag.revert{color:var(--accent);background:var(--accent-2);border-color:transparent}.muted{color:var(--muted)}.mono{font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace}.pager{display:flex;justify-content:space-between;align-items:center;margin-top:12px;color:var(--muted);font-size:11px}.pager .btn{padding:6px 9px}
.event-list{display:grid;gap:0;border:1px solid var(--border);background:var(--panel);border-radius:var(--radius);overflow:hidden}.event-row{display:grid;grid-template-columns:92px 140px 1fr 140px;gap:12px;padding:12px 14px;border-bottom:1px solid var(--border);font-size:12px;align-items:start}.event-row:last-child{border-bottom:0}.event-row:hover{background:var(--panel-2)}.event-time{font-variant-numeric:tabular-nums;color:var(--muted);font-size:10px}.event-main strong{display:block}.event-main small{display:block;color:var(--muted);margin-top:3px}.event-actor{color:var(--muted);font-size:11px}.empty{border:1px dashed var(--border);border-radius:var(--radius);padding:38px;text-align:center;color:var(--muted)}
.drawer{position:fixed;z-index:50;inset:0 0 0 auto;width:min(780px,92vw);background:var(--panel);box-shadow:-20px 0 50px rgba(0,0,0,.18);border-left:1px solid var(--border);overflow:auto}.drawer-head{position:sticky;top:0;background:color-mix(in srgb,var(--panel) 94%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:18px 20px;display:flex;justify-content:space-between;gap:12px;z-index:2}.drawer-head h2{font-size:17px;margin:0}.drawer-head p{margin:4px 0 0;color:var(--muted);font-size:11px}.close-btn{border:0;background:var(--panel-2);border-radius:8px;width:34px;height:34px;cursor:pointer}.drawer-body{padding:20px}.meta-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px}.meta-box{background:var(--panel-2);border:1px solid var(--border);border-radius:10px;padding:10px}.meta-box span{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.06em}.meta-box strong{display:block;font-size:12px;margin-top:3px;word-break:break-word}.tabs{display:flex;border-bottom:1px solid var(--border);margin:8px 0 16px}.tabs button{border:0;background:transparent;padding:9px 12px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent}.tabs button.active{color:var(--accent);border-bottom-color:var(--accent)}.codebox{border:1px solid var(--border);background:var(--panel-2);border-radius:11px;padding:14px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;line-height:1.6;max-height:58vh;overflow:auto}.rev-list{display:grid;gap:8px}.rev-item{border:1px solid var(--border);border-radius:10px;padding:10px 11px;display:grid;grid-template-columns:58px 1fr auto;gap:10px;align-items:center;cursor:pointer}.rev-item:hover{border-color:var(--accent)}.rev-seq{font-weight:700}.rev-info strong{font-size:11px;display:block}.rev-info span{font-size:10px;color:var(--muted)}.diff-line{display:block;padding:1px 4px;border-radius:3px}.diff-line.add{background:var(--ok-bg);color:var(--ok)}.diff-line.del{background:var(--danger-bg);color:var(--danger)}.diff-line.hunk{color:var(--accent)}
.search-results{display:grid;gap:18px}.result-section h3{font-size:12px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:0 0 8px}.result-list{display:grid;gap:7px}.result{border:1px solid var(--border);background:var(--panel);border-radius:10px;padding:10px 12px;cursor:pointer}.result:hover{border-color:var(--accent)}.result strong{font-size:12px}.result p{margin:4px 0 0;color:var(--muted);font-size:10px;line-height:1.5}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:99;background:var(--text);color:var(--panel);padding:9px 13px;border-radius:9px;font-size:11px;box-shadow:var(--shadow)}
@media (max-width:980px){.stats-grid{grid-template-columns:1fr 1fr}.grid-2{grid-template-columns:1fr}.event-row{grid-template-columns:80px 120px 1fr}.event-actor{display:none}}
@media (max-width:760px){#app{display:block}.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:none;box-shadow:20px 0 40px rgba(0,0,0,.2)}.main{grid-column:auto}.menu-btn{display:block}.topbar{padding:0 12px}.top-actions{display:none}.content{padding:18px 12px}.stats-grid{grid-template-columns:1fr 1fr;gap:8px}.stat{padding:14px}.stat-value{font-size:24px}.page-head{display:block}.actions{margin-top:12px}.filters input{min-width:100%;flex:1}.event-row{grid-template-columns:72px 1fr}.event-type{grid-column:2}.event-main{grid-column:2}.meta-grid{grid-template-columns:1fr 1fr}.drawer{width:100vw}.legend-grid{grid-template-columns:1fr 1fr}}
@media (max-width:420px){.stats-grid{grid-template-columns:1fr}.search-wrap kbd{display:none}.event-row{grid-template-columns:1fr}.event-type,.event-main{grid-column:1}.event-time{margin-bottom:-6px}.meta-grid{grid-template-columns:1fr}}
