const $ = (s, el=document) => el.querySelector(s);
const $$ = (s, el=document) => [...el.querySelectorAll(s)];
const content = $('#content');
const drawer = $('#drawer');
const fmt = new Intl.NumberFormat();
const state = { view:'overview', meta:null, pageOffset:0, descOffset:0, eventOffset:0, labelOffset:0, pageLimit:100, descLimit:120, eventLimit:100, labelLimit:100, descLetter:'' };

const DATA_ROOT = './data/';
const archive = {
  pages: [], descriptions: [], labels: [], events: [], revisions: [],
  pageById: new Map(), descriptionByPage: new Map(), labelByName: new Map(), revSummaryById: new Map(),
  revsByPage: new Map(), eventsByPageKey: new Map(), shardCache: new Map(),
};

const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const n = v => fmt.format(v ?? 0);
const dt = v => v ? new Date(v).toLocaleString([], {year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
const shortDate = v => v ? new Date(v).toLocaleDateString([], {month:'short',day:'numeric',year:'2-digit'}) : '—';
const bytes = v => { if(v == null) return '—'; const u=['B','KB','MB','GB']; let i=0,x=v; while(x>=1024&&i<u.length-1){x/=1024;i++} return `${x.toFixed(i?1:0)} ${u[i]}`; };
const clampPct = (v,max) => max ? Math.max(2, (v/max)*100) : 0;
const contains = (hay, needle) => String(hay ?? '').toLowerCase().includes(needle);

function status(text, mode='ok'){
  $('#statusText').textContent=text;
  const dot=$('#statusDot');
  dot.style.background = mode==='error' ? 'var(--danger)' : mode==='busy' ? 'var(--warn)' : 'var(--ok)';
}

async function fetchTextMaybeGzip(url){
  const r=await fetch(url);
  if(!r.ok) throw new Error(`Couldn’t load ${url} (${r.status})`);
  const raw=await r.arrayBuffer();
  const u8=new Uint8Array(raw);
  if(u8.length>=2 && u8[0]===0x1f && u8[1]===0x8b){
    if(!('DecompressionStream' in window)) throw new Error('This browser does not support gzip decompression (DecompressionStream). Try a current Chrome, Safari, Firefox, or Edge release.');
    const stream=new Blob([raw]).stream().pipeThrough(new DecompressionStream('gzip'));
    return new Response(stream).text();
  }
  return new TextDecoder().decode(u8);
}

async function loadJsonlGz(url){
  const text=await fetchTextMaybeGzip(url);
  const rows=[];
  for(const line of text.split(/\r?\n/)) if(line.trim()) rows.push(JSON.parse(line));
  return rows;
}

function addMapList(map,key,value){ if(!map.has(key))map.set(key,[]); map.get(key).push(value); }
function pageMatches(p,q){ return contains(p.name,q)||contains(p.page_id,q)||contains(p.page_family,q)||contains(p.description,q)||(p.labels||[]).some(x=>contains(x,q)); }
function eventMatches(e,q){ return ['page','page_key','actor_label','ip16','request_action','change_summary','event_id','param_family'].some(k=>contains(e[k],q)); }
function eventSummary(e){ const keys=['event_id','event_type','time','time_grade','wiki','page','page_key','revision_ref','related_event_id','relation_type','ip16','request_action','param_family','success_observed','change_summary','actor_label','page_held']; return Object.fromEntries(keys.filter(k=>k in e).map(k=>[k,e[k]])); }
function makeSnippet(text,q,radius=120){ const low=text.toLowerCase(),i=low.indexOf(q); if(i<0)return text.slice(0,radius*2); const a=Math.max(0,i-radius),b=Math.min(text.length,i+q.length+radius); return `${a?'…':''}${text.slice(a,b).replace(/\s+/g,' ')}${b<text.length?'…':''}`; }
function splitLines(text){ if(!text)return []; const lines=String(text).replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n'); if(lines.at(-1)==='')lines.pop(); return lines; }
function rangeText(start,count){ if(count===0)return `${start},0`; if(count===1)return `${start+1}`; return `${start+1},${count}`; }
function buildUnifiedDiff(base,rev){
  const hunks=rev.hunks||[];
  if(!hunks.length)return [];
  const before=splitLines(base?.body||''),after=splitLines(rev.body||'');
  const out=[`--- ${base?.rev_id||'(new page)'}`,`+++ ${rev.rev_id}`];
  for(const h of hunks){
    const a0=Math.max(0,h.a0??0),a1=Math.max(a0,h.a1??a0),b0=Math.max(0,h.b0??0),b1=Math.max(b0,h.b1??b0);
    const pre=Math.min(3,a0,b0),aStart=a0-pre,bStart=b0-pre;
    const post=Math.min(3,before.length-a1,after.length-b1),aEnd=a1+post,bEnd=b1+post;
    out.push(`@@ -${rangeText(aStart,aEnd-aStart)} +${rangeText(bStart,bEnd-bStart)} @@`);
    for(let i=0;i<pre;i++) out.push(' '+(before[aStart+i]??''));
    for(let i=a0;i<a1;i++) out.push('-'+(before[i]??''));
    for(let i=b0;i<b1;i++) out.push('+'+(after[i]??''));
    for(let i=0;i<post;i++) out.push(' '+(after[b1+i]??''));
  }
  return out;
}

async function loadRevisionShard(id){
  if(archive.shardCache.has(id)) return archive.shardCache.get(id);
  const key=String(id).padStart(2,'0');
  const promise=loadJsonlGz(`${DATA_ROOT}revisions/${key}.jsonl.gz`).then(rows=>new Map(rows.map(r=>[r.rev_id,r])));
  archive.shardCache.set(id,promise);
  return promise;
}
async function getRevision(id){
  const s=archive.revSummaryById.get(id);
  if(!s)throw new Error('Revision not found');
  const shard=await loadRevisionShard(s.shard);
  const r=shard.get(id);
  if(!r)throw new Error('Revision body not found');
  return r;
}
async function loadAllRevisionShards(){
  const count=state.meta.revision_shards||16;
  const ids=[...Array(count).keys()];
  let done=0;
  for(let i=0;i<ids.length;i+=4){
    const batch=ids.slice(i,i+4);
    await Promise.all(batch.map(loadRevisionShard));
    done+=batch.length;
    status(`Deep search: loaded ${done}/${count} revision shards…`,'busy');
  }
}

async function initArchive(){
  status('Loading archive indexes…','busy');
  const [meta,pages,descriptions,labels,events,revisions]=await Promise.all([
    fetch(`${DATA_ROOT}meta.json`).then(r=>{if(!r.ok)throw new Error('Couldn’t load archive metadata');return r.json()}),
    loadJsonlGz(`${DATA_ROOT}pages.jsonl.gz`),
    loadJsonlGz(`${DATA_ROOT}page-descriptions.jsonl.gz`),
    loadJsonlGz(`${DATA_ROOT}labels.jsonl.gz`),
    loadJsonlGz(`${DATA_ROOT}events.jsonl.gz`),
    loadJsonlGz(`${DATA_ROOT}revision-summaries.jsonl.gz`),
  ]);
  state.meta=meta; archive.pages=pages; archive.descriptions=descriptions; archive.labels=labels; archive.events=events; archive.revisions=revisions;
  for(const d of descriptions) archive.descriptionByPage.set(d.page_id,d);
  for(const p of pages){ const d=archive.descriptionByPage.get(p.page_id); if(d){p.description=d.description;p.description_source=d.description_source;p.description_prefix=d.prefix} archive.pageById.set(p.page_id,p); }
  for(const l of labels) archive.labelByName.set(l.label||'',l);
  for(const r of revisions){ archive.revSummaryById.set(r.rev_id,r); addMapList(archive.revsByPage,r.page_id,r); }
  for(const rows of archive.revsByPage.values()) rows.sort((a,b)=>(a.seq||0)-(b.seq||0)||String(a.time||'').localeCompare(String(b.time||'')));
  for(const e of events) if(e.page_key)addMapList(archive.eventsByPageKey,e.page_key,e);
  for(const rows of archive.eventsByPageKey.values()) rows.sort((a,b)=>String(a.time||'').localeCompare(String(b.time||'')));
  status('Static archive loaded');
}

async function api(path,params={}){
  if(path==='meta')return state.meta;
  if(path==='pages'){
